#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  status)
    exec /usr/local/bin/vfio-status
    ;;

  enable)
    exec /usr/local/bin/vfio-enable
    ;;

  disable)
    exec /usr/local/bin/vfio-disable
    ;;

  bind)
    exec /usr/local/bin/unbind_gpu.sh
    ;;

  unbind)
    exec /usr/local/bin/rebind_gpu.sh
    ;;

  *)
    cat <<USAGE
Usage:
  sudo vfio status
  sudo vfio enable
  sudo vfio disable

Optional runtime, only installed when vfio_install_runtime_scripts=true:
  sudo vfio bind
  sudo vfio unbind

Notes:
  vfio enable/disable will only reboot automatically if vfio_allow_reboot=true
USAGE
    exit 1
    ;;
esac
