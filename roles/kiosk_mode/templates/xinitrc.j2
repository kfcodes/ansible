#!/usr/bin/env sh
set -eu

# Disable screen blanking and power management.
{% if kiosk_disable_screen_blanking | bool %}
if command -v xset >/dev/null 2>&1; then
  xset s off || true
  xset s noblank || true
  xset -dpms || true
fi
{% endif %}

# Window manager.
{{ kiosk_window_manager_command }} &

# On-screen keyboard.
{% if kiosk_enable_onboard | bool %}
if command -v onboard >/dev/null 2>&1; then
  onboard &
fi
{% endif %}

# Hide mouse cursor when idle.
{% if kiosk_enable_unclutter | bool %}
if command -v unclutter >/dev/null 2>&1; then
  unclutter &
fi
{% endif %}

# Let WM/keyboard settle.
sleep 1

# Browser in kiosk mode.
exec {{ kiosk_browser | quote }}{% for flag in kiosk_browser_flags %} {{ flag | quote }}{% endfor %}
